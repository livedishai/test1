        <path d="M12.004 2c-5.514 0-9.996 4.478-9.996 9.997 0 1.763.464 3.483 1.346 4.997L2 22l5.146-1.336a9.96 9.96 0 0 0 4.858 1.24h.004c5.514 0 9.992-4.478 9.992-9.997C21.996 6.478 17.518 2 12.004 2zm0 18.19h-.003a8.19 8.19 0 0 1-4.174-1.14l-.3-.178-3.06.795.818-2.988-.196-.307a8.185 8.185 0 0 1-1.257-4.375c0-4.527 3.685-8.211 8.213-8.211 2.193 0 4.253.855 5.804 2.406a8.153 8.153 0 0 1 2.406 5.808c0 4.528-3.684 8.19-8.251 8.19z"/>
      </svg>
    </a>
  </div>

  <div class="button-panel" id="planButtons">
    <button class="plan-button" id="toggleButton">▶ Play Video</button>
    <button class="plan-button catalog-trigger" id="openCatalogBtn">✦ View Catalogue</button>
  </div>

  <div id="catalogSheet">
    
    <div class="catalog-bg">
      <div class="holo-grid"></div>
      <div class="glow-orb glow-orb-1"></div>
      <div class="glow-orb glow-orb-2"></div>
    </div>

    <div class="sheet-sticky-top">
      <div class="sheet-handle-wrap" id="sheetHandle">
        <div class="sheet-handle"></div>
      </div>
      <div class="sheet-header">
        <div class="sheet-title">Collection Vault<span>Holographic Showcase</span></div>
        <button class="close-btn" id="closeCatalogBtn" aria-label="Close catalog">&times;</button>
      </div>

      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" class="search-input" id="catalogSearch" placeholder="Search handcrafted designs..." autocomplete="off" />
      </div>

      <div class="category-scroll" id="categoryTabs">
        <button class="category-chip active" data-cat="all">All Vault</button>
        <button class="category-chip" data-cat="bridal">Bridal</button>
        <button class="category-chip" data-cat="necklaces">Necklaces</button>
        <button class="category-chip" data-cat="bangles">Bangles</button>
      </div>
    </div>

    <div class="catalog-grid" id="catalogList"></div>
  </div>

  <div id="productModal">
    <div class="modal-box">
      <div class="modal-img-wrap">
        <img id="modalImg" src="" alt="Piece Preview" />
      </div>
      <div>
        <div class="modal-purity" id="modalPurity">22K BIS HALLMARKED</div>
        <div class="modal-title" id="modalName">Royal Kundan Choker</div>
      </div>
      <button class="modal-action-btn" id="modalWhatsAppBtn">
        Inquire via WhatsApp
      </button>
      <div class="modal-close-link" id="modalCloseBtn">Back to Vault</div>
    </div>
  </div>

  <a-scene
    mindar-image="imageTargetSrc: ./targets.mind; uiLoading: no; uiError: no; filterMinCF:0.0001; filterBeta: 0.001;"
    vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false"
    renderer="antialias: true; alpha: true">

    <a-assets>
      <video id="driveVideo" playsinline webkit-playsinline preload="auto" loop crossorigin="anonymous"></video>
    </a-assets>

    <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>

    <a-entity id="target1" mindar-image-target="targetIndex: 0">
      <a-plane id="videoPlane" width="1" height="1" visible="false" material="src: #driveVideo; side: double; transparent: true"></a-plane>
    </a-entity>
  </a-scene>

  <script>
    const API_KEY = "AIzaSyA_mBu6emRKASkqHpLtwkdBiCQKYO3rvcw"; 
    const FOLDER_ID = "1jRyVReP4cq7yk1VqwdFCMt0w4on4S77Q";
    const STORE_WHATSAPP = "910000000000"; // Replace with your number

    const CATALOG_ITEMS = [
      { id: 1, name: "Kundan Royal Choker", category: "bridal", purity: "22K Yellow Gold", price: "₹2,45,000", img: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500" },
      { id: 2, name: "Temple Heritage Haram", category: "necklaces", purity: "22K Antique Polish", price: "₹3,10,000", img: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=500" },
      { id: 3, name: "Filigree Bridal Kadas", category: "bangles", purity: "22K Solid Gold", price: "₹1,85,000", img: "https://images.unsplash.com/photo-1611591475824-7890f576e107?w=500" },
      { id: 4, name: "Rani Haar Polki Ensemble", category: "bridal", purity: "24K Foil Kundan", price: "₹4,20,000", img: "https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?w=500" }
    ];

    async function getLatestVideoId() {
      try {
        const url = `https://www.googleapis.com/drive/v3/files?q='${FOLDER_ID}'+in+parents+and+mimeType+contains+'video/'&orderBy=modifiedTime desc&pageSize=1&fields=files(id)&key=${API_KEY}`;
        const response = await fetch(url);
        const data = await response.json();
        return (data.files && data.files.length > 0) ? data.files[0].id : null;
      } catch (error) {
        console.error("Drive Fetch Error:", error);
        return null;
      }
    }

    window.addEventListener("load", () => {
      const videoEl = document.querySelector("#driveVideo");
      const videoPlane = document.querySelector("#videoPlane");
      const target = document.querySelector("#target1");
      const toggleButton = document.querySelector("#toggleButton");
      const buttonsContainer = document.querySelector("#planButtons");
      const curtain = document.querySelector("#blackCurtain");
      const sceneEl = document.querySelector('a-scene');

      const openCatalogBtn = document.querySelector("#openCatalogBtn");
      const closeCatalogBtn = document.querySelector("#closeCatalogBtn");
      const catalogSheet = document.querySelector("#catalogSheet");
      const catalogList = document.querySelector("#catalogList");
      const categoryTabs = document.querySelectorAll(".category-chip");
      const catalogSearch = document.querySelector("#catalogSearch");
      const sheetHandle = document.querySelector("#sheetHandle");

      // Inspection modal elements
      const productModal = document.querySelector("#productModal");
      const modalImg = document.querySelector("#modalImg");
      const modalName = document.querySelector("#modalName");
      const modalPurity = document.querySelector("#modalPurity");
      const modalWhatsAppBtn = document.querySelector("#modalWhatsAppBtn");
      const modalCloseBtn = document.querySelector("#modalCloseBtn");

      let isPlaying = false;
      let activeCategory = "all";
      let selectedProduct = null;

      function renderCatalog() {
        const query = (catalogSearch.value || "").trim().toLowerCase();
        catalogList.innerHTML = "";

        const filtered = CATALOG_ITEMS.filter(item => {
          const matchesCat = activeCategory === "all" || item.category === activeCategory;
          const matchesQuery = !query || item.name.toLowerCase().includes(query);
          return matchesCat && matchesQuery;
        });

        if (filtered.length === 0) {
          const empty = document.createElement("div");
          empty.style.gridColumn = "1 / -1";
          empty.style.textAlign = "center";
          empty.style.padding = "60px 20px";
          empty.style.color = "var(--cream-dim)";
          empty.textContent = "No jewelry matching your query in the vault.";
          catalogList.appendChild(empty);
          return;
        }

        filtered.forEach((item, index) => {
          const card = document.createElement("div");
          card.className = "catalog-card";
          card.style.animationDelay = `${index * 60}ms`;
          card.innerHTML = `
            <div class="img-wrap">
              <span class="purity-badge">${item.purity.split(' ')[0]}</span>
              <img src="${item.img}" alt="${item.name}" loading="lazy" />
            </div>
            <div class="tag">${item.category}</div>
            <div class="name">${item.name}</div>
            <div class="price">
              <span>${item.price}</span>
              <div class="action-arrow">→</div>
            </div>
          `;

          card.addEventListener("click", () => {
            selectedProduct = item;
            modalImg.src = item.img;
            modalName.textContent = item.name;
            modalPurity.textContent = `${item.purity} • ${item.price}`;
            productModal.classList.add("visible");
          });

          catalogList.appendChild(card);
        });
      }

      renderCatalog();

      categoryTabs.forEach(chip => {
        chip.addEventListener("click", () => {
          categoryTabs.forEach(c => c.classList.remove("active"));
          chip.classList.add("active");
          activeCategory = chip.dataset.cat;
          renderCatalog();
        });
      });

      catalogSearch.addEventListener("input", renderCatalog);

      function openCatalog() {
        catalogSheet.classList.add("open");
        document.body.classList.add("catalog-open");
      }

      function closeCatalog() {
        catalogSheet.classList.remove("open");
        document.body.classList.remove("catalog-open");
      }

      openCatalogBtn.addEventListener("click", openCatalog);
      closeCatalogBtn.addEventListener("click", closeCatalog);

      // Modal Actions
      modalCloseBtn.addEventListener("click", () => productModal.classList.remove("visible"));
      modalWhatsAppBtn.addEventListener("click", () => {
        if (!selectedProduct) return;
        const msg = encodeURIComponent(`Hi, I'm interested in viewing the ${selectedProduct.name} (${selectedProduct.price}) from your Jewels-AI AR Showcase!`);
        window.open(`https://wa.me/${STORE_WHATSAPP}?text=${msg}`, "_blank");
      });

      // Drag to dismiss
      let dragStartY = 0;
      let dragDeltaY = 0;
      let dragging = false;

      sheetHandle.addEventListener("touchstart", (e) => {
        dragStartY = e.touches[0].clientY;
        dragging = true;
      }, { passive: true });

      sheetHandle.addEventListener("touchmove", (e) => {
        if (!dragging) return;
        dragDeltaY = Math.max(0, e.touches[0].clientY - dragStartY);
        catalogSheet.style.transform = `translateY(${dragDeltaY}px)`;
      }, { passive: true });

      sheetHandle.addEventListener("touchend", () => {
        catalogSheet.style.transform = "";
        if (dragDeltaY > 120) closeCatalog();
        dragging = false;
        dragDeltaY = 0;
      });

      function dismissCurtain() {
        if (curtain) {
          curtain.style.opacity = "0";
          setTimeout(() => { curtain.style.display = "none"; }, 600);
        }
      }

      sceneEl.addEventListener("arReady", dismissCurtain);
      sceneEl.addEventListener("arError", dismissCurtain);

      function adjustPlaneToVideoRatio() {
        if (!videoPlane || !videoEl) return;
        const w = videoEl.videoWidth;
        const h = videoEl.videoHeight;
        if (w > 0 && h > 0) {
          const aspectRatio = w / h;
          videoPlane.setAttribute('geometry', {
            primitive: 'plane',
            width: aspectRatio >= 1 ? 1 : aspectRatio,
            height: aspectRatio >= 1 ? (1 / aspectRatio) : 1
          });
        }
      }

      videoEl.addEventListener('loadedmetadata', adjustPlaneToVideoRatio);
      videoEl.addEventListener('playing', () => {
        adjustPlaneToVideoRatio();
        if (videoPlane) videoPlane.setAttribute('visible', 'true');
      });

      target.addEventListener("targetFound", async () => {
        document.body.classList.add("found");
        buttonsContainer.style.display = "flex";
        const fileId = await getLatestVideoId();
        if (fileId) {
          const newSrc = `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media&key=${API_KEY}`;
          if (videoEl.src !== newSrc) {
            videoEl.src = newSrc;
            videoEl.load();
          }
        }
      });

      target.addEventListener("targetLost", () => {
        document.body.classList.remove("found");
        videoEl.pause();
        if (videoPlane) videoPlane.setAttribute('visible', 'false');
        isPlaying = false;
        toggleButton.textContent = "▶ Play Video";
      });

      toggleButton.addEventListener("click", async () => {
        try {
          if (!isPlaying) {
            videoEl.muted = false;
            await videoEl.play();
            toggleButton.textContent = "⏸ Pause Video";
            isPlaying = true;
          } else {
            videoEl.pause();
            toggleButton.textContent = "▶ Play Video";
            isPlaying = false;
          }
        } catch (err) {
          console.error("Playback error:", err);
        }
      });
    });
  </script>
</body>
</html>
