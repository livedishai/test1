<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>JEWELS-AI | Live Drive AR</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Orbitron:wght@600;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

  <style>
    :root {
      --deep: #090312;
      --deep-card: rgba(18, 8, 33, 0.72);
      --brand-purple: #7212B0;
      --brand-purple-dark: #2c0a49;
      --gold: #E5C158;
      --gold-soft: #F9E7A2;
      --gold-glow: rgba(229, 193, 88, 0.45);
      --cream: #F5EFE6;
      --cream-dim: rgba(245, 239, 230, 0.65);
      --glass: rgba(255, 255, 255, 0.05);
      --glass-border: rgba(229, 193, 88, 0.28);
      --neon-cyan: #00f2fe;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--deep);
      overflow: hidden;
      font-family: 'Manrope', sans-serif;
      color: var(--cream);
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    /* ---------- Loading Screen ---------- */
    #blackCurtain {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at 50% 40%, #1f0d33 0%, var(--deep) 70%);
      z-index: 9999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 22px;
      transition: opacity 0.6s ease;
      pointer-events: none;
    }

    .gem-loader {
      width: 56px;
      height: 56px;
      animation: gemSpin 2.6s ease-in-out infinite;
    }

    .gem-loader path {
      fill: none;
      stroke: var(--gold);
      stroke-width: 1.5;
      stroke-linejoin: round;
      filter: drop-shadow(0 0 8px var(--gold-glow));
    }

    @keyframes gemSpin {
      0%   { transform: rotate(0deg) scale(1); }
      50%  { transform: rotate(180deg) scale(1.08); }
      100% { transform: rotate(360deg) scale(1); }
    }

    #loader {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      font-style: italic;
      font-size: 20px;
      letter-spacing: 2px;
      color: var(--cream);
      text-align: center;
    }

    #loader span {
      display: block;
      font-family: 'Manrope', sans-serif;
      font-style: normal;
      font-size: 10px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--gold-soft);
      margin-top: 6px;
    }

    /* ---------- Brand mark ---------- */
    #brandMark {
      position: fixed;
      top: max(18px, env(safe-area-inset-top));
      left: 50%;
      transform: translateX(-50%);
      z-index: 500;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      background: rgba(18, 8, 33, 0.7);
      border: 1px solid var(--glass-border);
      border-radius: 999px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: 3px;
      color: var(--gold-soft);
      box-shadow: 0 4px 20px rgba(0,0,0,0.5), inset 0 0 10px rgba(229,193,88,0.1);
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    #brandMark::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 8px var(--gold);
    }

    /* ---------- Scan hint ---------- */
    #scanHint {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 400;
      width: min(64vw, 260px);
      aspect-ratio: 1;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }

    #scanHint .corner {
      position: absolute;
      width: 28px;
      height: 28px;
      border: 2px solid var(--gold);
      opacity: 0.85;
      filter: drop-shadow(0 0 4px var(--gold-glow));
    }
    #scanHint .tl { top: 0; left: 0; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
    #scanHint .tr { top: 0; right: 0; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
    #scanHint .bl { bottom: 0; left: 0; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
    #scanHint .br { bottom: 0; right: 0; border-left: none; border-top: none; border-radius: 0 0 6px 0; }

    #scanHint .scanline {
      position: absolute;
      left: 4px;
      right: 4px;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      box-shadow: 0 0 12px var(--gold);
      animation: scanMove 2.2s ease-in-out infinite;
    }

    @keyframes scanMove {
      0%   { top: 6%; opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { top: 92%; opacity: 0; }
    }

    #scanHint p {
      position: absolute;
      bottom: -36px;
      width: 100%;
      text-align: center;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--cream-dim);
    }

    body.found #scanHint,
    body.found #brandMark {
      opacity: 0;
    }

    /* ---------- Bottom Control Panel ---------- */
    .button-panel {
      position: fixed;
      bottom: max(28px, env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%) translateY(16px);
      display: flex;
      gap: 12px;
      opacity: 0;
      z-index: 100;
      transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    body.found .button-panel,
    body.catalog-open .button-panel {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
    }

    .plan-button {
      position: relative;
      overflow: hidden;
      padding: 13px 26px;
      font-family: 'Manrope', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      border: 1px solid var(--glass-border);
      border-radius: 999px;
      background: linear-gradient(135deg, var(--brand-purple) 0%, var(--brand-purple-dark) 100%);
      color: var(--cream);
      cursor: pointer;
      box-shadow: 0 8px 30px rgba(0,0,0,0.6), inset 0 0 10px rgba(255,255,255,0.1);
      backdrop-filter: blur(8px);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      white-space: nowrap;
    }

    .plan-button.catalog-trigger {
      background: rgba(18, 8, 33, 0.85);
      border: 1px solid var(--gold);
      color: var(--gold-soft);
      box-shadow: 0 8px 24px rgba(229,193,88,0.2);
    }

    .plan-button:active {
      transform: scale(0.96);
    }

    /* ---------- FUTURISTIC FULLSCREEN CATALOGUE ---------- */
    #catalogSheet {
      position: fixed;
      inset: 0;
      height: 100dvh;
      background: radial-gradient(circle at 50% 10%, rgba(56, 17, 94, 0.4) 0%, rgba(9, 3, 18, 0.98) 75%);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      z-index: 2000;
      display: flex;
      flex-direction: column;
      transform: translateY(100%) scale(0.98);
      opacity: 0;
      transition: transform 0.5s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.4s ease;
      overscroll-behavior: contain;
      overflow: hidden;
    }

    #catalogSheet.open {
      transform: translateY(0) scale(1);
      opacity: 1;
    }

    /* Ambient animated holographic grid & beams */
    .catalog-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .catalog-bg .holo-grid {
      position: absolute;
      inset: -50%;
      background-image: 
        linear-gradient(rgba(229, 193, 88, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(229, 193, 88, 0.04) 1px, transparent 1px);
      background-size: 32px 32px;
      transform: perspective(500px) rotateX(60deg);
      opacity: 0.6;
      animation: gridDrift 20s linear infinite;
    }

    @keyframes gridDrift {
      0%   { transform: perspective(500px) rotateX(60deg) translateY(0); }
      100% { transform: perspective(500px) rotateX(60deg) translateY(32px); }
    }

    .catalog-bg .glow-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
    }

    .glow-orb-1 {
      width: 320px; height: 320px;
      top: -80px; right: -60px;
      background: radial-gradient(circle, var(--brand-purple) 0%, transparent 70%);
    }

    .glow-orb-2 {
      width: 260px; height: 260px;
      bottom: -40px; left: -50px;
      background: radial-gradient(circle, var(--gold) 0%, transparent 70%);
      opacity: 0.15;
    }

    .sheet-sticky-top {
      position: relative;
      z-index: 5;
      padding-top: env(safe-area-inset-top);
      background: linear-gradient(180deg, rgba(14, 5, 26, 0.95) 0%, rgba(14, 5, 26, 0.6) 85%, transparent 100%);
      border-bottom: 1px solid rgba(229, 193, 88, 0.15);
      flex-shrink: 0;
    }

    .sheet-handle-wrap {
      width: 100%;
      padding: 10px 0 4px;
      display: flex;
      justify-content: center;
      cursor: grab;
    }

    .sheet-handle {
      width: 48px;
      height: 4px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      border-radius: 999px;
      box-shadow: 0 0 10px var(--gold-glow);
    }

    .sheet-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 22px 14px;
    }

    .sheet-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
      letter-spacing: 1.5px;
      color: #FFFFFF;
      text-shadow: 0 0 20px rgba(229,193,88,0.3);
    }

    .sheet-title span {
      display: block;
      font-family: 'Orbitron', monospace;
      font-size: 9px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold);
      margin-top: 4px;
    }

    .close-btn {
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--glass-border);
      border-radius: 50%;
      color: var(--gold-soft);
      font-size: 20px;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: all 0.25s ease;
    }

    .close-btn:active {
      transform: rotate(90deg) scale(0.92);
      border-color: var(--gold);
      background: rgba(229,193,88,0.2);
    }

    /* Cyber Search Bar */
    .search-wrap {
      padding: 0 22px 12px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 12px 16px 12px 42px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(229, 193, 88, 0.2);
      border-radius: 14px;
      color: var(--cream);
      font-family: 'Manrope', sans-serif;
      font-size: 13px;
      outline: none;
      transition: all 0.3s ease;
    }

    .search-input:focus {
      border-color: var(--gold);
      background: rgba(229, 193, 88, 0.06);
      box-shadow: 0 0 18px rgba(229, 193, 88, 0.2);
    }

    .search-icon {
      position: absolute;
      left: 36px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      opacity: 0.6;
      stroke: var(--gold);
      pointer-events: none;
    }

    /* Holographic Category Selector */
    .category-scroll {
      display: flex;
      gap: 10px;
      padding: 2px 22px 14px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .category-scroll::-webkit-scrollbar { display: none; }

    .category-chip {
      padding: 8px 18px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(229, 193, 88, 0.2);
      color: var(--cream-dim);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .category-chip.active {
      background: linear-gradient(135deg, var(--gold) 0%, #b89324 100%);
      color: #0c0517;
      border-color: var(--gold-soft);
      font-weight: 800;
      box-shadow: 0 0 16px rgba(229, 193, 88, 0.45);
      transform: scale(1.04);
    }

    /* Holographic Product Grid */
    .catalog-grid {
      position: relative;
      z-index: 1;
      flex: 1;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      padding: 16px 22px calc(40px + env(safe-area-inset-bottom));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      align-content: start;
    }

    @keyframes holoCardIn {
      from {
        opacity: 0;
        transform: translateY(28px) scale(0.93);
        filter: blur(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    .catalog-card {
      position: relative;
      background: var(--deep-card);
      border: 1px solid var(--glass-border);
      border-radius: 18px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      overflow: hidden;
      backdrop-filter: blur(12px);
      animation: holoCardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      cursor: pointer;
    }

    /* Cyber holographic corner trims */
    .catalog-card::before {
      content: "";
      position: absolute;
      top: 0; right: 0;
      width: 24px; height: 24px;
      background: linear-gradient(135deg, transparent 50%, rgba(229, 193, 88, 0.35) 50%);
      border-top-right-radius: 18px;
    }

    .catalog-card:active {
      transform: scale(0.96) translateY(2px);
      border-color: var(--gold);
      box-shadow: 0 0 25px rgba(229, 193, 88, 0.3);
    }

    .catalog-card .img-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 1;
      border-radius: 14px;
      overflow: hidden;
      background: #190a2a;
    }

    .catalog-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .catalog-card:active img {
      transform: scale(1.08);
    }

    .purity-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(9, 3, 18, 0.78);
      border: 1px solid rgba(229, 193, 88, 0.4);
      border-radius: 6px;
      padding: 3px 6px;
      font-size: 9px;
      font-family: 'Orbitron', monospace;
      color: var(--gold-soft);
      letter-spacing: 1px;
      backdrop-filter: blur(6px);
    }

    .catalog-card .tag {
      font-size: 10px;
      text-transform: uppercase;
      color: var(--gold-soft);
      letter-spacing: 1.5px;
      font-weight: 600;
    }

    .catalog-card .name {
      font-size: 13px;
      font-weight: 600;
      color: var(--cream);
      line-height: 1.35;
    }

    .catalog-card .price {
      font-family: 'Orbitron', monospace;
      font-size: 13px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: 0.5px;
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .catalog-card .action-arrow {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(229, 193, 88, 0.15);
      border: 1px solid var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      font-size: 10px;
    }

    /* ---------- WhatsApp Quick FAB ---------- */
    .social-fab {
      position: fixed;
      bottom: max(96px, calc(env(safe-area-inset-bottom) + 96px));
      right: 18px;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      gap: 12px;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.45s ease, transform 0.45s ease;
      pointer-events: none;
    }

    body.found .social-fab,
    body.catalog-open .social-fab {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .social-fab a {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 20px rgba(0,0,0,0.5), 0 0 12px rgba(37, 211, 102, 0.35);
      text-decoration: none;
      border: 1.5px solid rgba(255, 255, 255, 0.4);
      background: #25D366;
      transition: transform 0.2s ease;
    }

    .social-fab a:active { transform: scale(0.9); }
    .social-fab svg { width: 24px; height: 24px; }

    /* ---------- Floating Hologram Quick Inspector Modal ---------- */
    #productModal {
      position: fixed;
      inset: 0;
      background: rgba(9, 3, 18, 0.85);
      backdrop-filter: blur(14px);
      z-index: 3000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    #productModal.visible {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      width: 100%;
      max-width: 340px;
      background: radial-gradient(circle at 50% 0%, #290f42 0%, #120722 80%);
      border: 1px solid var(--gold);
      box-shadow: 0 0 35px var(--gold-glow);
      border-radius: 24px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      transform: scale(0.9);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #productModal.visible .modal-box {
      transform: scale(1);
    }

    .modal-img-wrap {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--glass-border);
    }

    .modal-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--cream);
    }

    .modal-purity {
      font-family: 'Orbitron', monospace;
      font-size: 11px;
      color: var(--gold-soft);
      letter-spacing: 1px;
    }

    .modal-action-btn {
      width: 100%;
      padding: 13px;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
      color: #FFFFFF;
      font-weight: 700;
      letter-spacing: 1px;
      font-size: 13px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 18px rgba(37,211,102,0.35);
    }

    .modal-close-link {
      text-align: center;
      font-size: 12px;
      color: var(--cream-dim);
      cursor: pointer;
      padding-top: 4px;
    }

    .a-enter-vr, .a-enter-ar, .a-orientation-modal, .mindar-ui-loading, .mindar-ui-compatibility {
      display: none !important;
    }
  </style>
</head>

