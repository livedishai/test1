<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>JEWELS-AI | Live Drive AR</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

  <style>
    :root {
      --deep: #130821;
      --deep-2: #1f0d33;
      --brand-purple: #5E0F8B;
      --brand-purple-dark: #2c0a49;
      --gold: #D4AF37;
      --gold-soft: #F0D687;
      --cream: #F5EFE6;
      --cream-dim: rgba(245, 239, 230, 0.62);
      --glass: rgba(245, 239, 230, 0.08);
      --glass-border: rgba(212, 175, 55, 0.35);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--deep);
      overflow: hidden;
      font-family: 'Manrope', sans-serif;
      color: var(--cream);
      -webkit-tap-highlight-color: transparent;
    }

    /* ---------- Loading curtain ---------- */
    #blackCurtain {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 50% 40%, var(--deep-2) 0%, var(--deep) 70%);
      z-index: 9999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 22px;
      transition: opacity 0.6s ease;
      pointer-events: none;
    }

    .gem-loader {
      width: 56px;
      height: 56px;
      animation: gemSpin 2.6s ease-in-out infinite;
    }

    .gem-loader path {
      fill: none;
      stroke: var(--gold);
      stroke-width: 1.4;
      stroke-linejoin: round;
      filter: drop-shadow(0 0 6px rgba(212,175,55,0.55));
    }

    @keyframes gemSpin {
      0%   { transform: rotate(0deg) scale(1); }
      50%  { transform: rotate(180deg) scale(1.08); }
      100% { transform: rotate(360deg) scale(1); }
    }

    #loader {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      font-style: italic;
      font-size: 19px;
      letter-spacing: 2px;
      color: var(--cream);
      text-align: center;
      animation: pulse 1.8s ease-in-out infinite;
    }

    #loader span {
      display: block;
      font-family: 'Manrope', sans-serif;
      font-style: normal;
      font-size: 10px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--gold-soft);
      margin-top: 6px;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.55; }
      50% { opacity: 1; }
    }

    /* ---------- Brand mark ---------- */
    #brandMark {
      position: fixed;
      top: max(18px, env(safe-area-inset-top));
      left: 50%;
      transform: translateX(-50%);
      z-index: 500;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: 999px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: 3px;
      color: var(--gold-soft);
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    #brandMark::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 8px var(--gold);
    }

    /* ---------- Scan hint / viewfinder ---------- */
    #scanHint {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 400;
      width: min(64vw, 260px);
      aspect-ratio: 1;
      transition: opacity 0.4s ease, transform 0.4s ease;
      pointer-events: none;
    }

    #scanHint .corner {
      position: absolute;
      width: 30px;
      height: 30px;
      border: 2px solid var(--gold);
      opacity: 0.85;
    }
    #scanHint .tl { top: 0; left: 0; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
    #scanHint .tr { top: 0; right: 0; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
    #scanHint .bl { bottom: 0; left: 0; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
    #scanHint .br { bottom: 0; right: 0; border-left: none; border-top: none; border-radius: 0 0 6px 0; }

    #scanHint .scanline {
      position: absolute;
      left: 4px;
      right: 4px;
      height: 1.5px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      box-shadow: 0 0 8px var(--gold);
      animation: scanMove 2.2s ease-in-out infinite;
    }

    @keyframes scanMove {
      0%   { top: 6%; opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { top: 92%; opacity: 0; }
    }

    #scanHint p {
      position: absolute;
      bottom: -34px;
      width: 100%;
      text-align: center;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--cream-dim);
    }

    body.found #scanHint,
    body.found #brandMark {
      opacity: 0;
    }

    /* ---------- Bottom control panel ---------- */
    .button-panel {
      position: fixed;
      bottom: max(28px, env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%) translateY(16px);
      display: flex;
      opacity: 0;
      z-index: 100;
      transition: opacity 0.45s ease, transform 0.45s ease;
      pointer-events: none;
    }

    body.found .button-panel {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
    }

    .plan-button {
      position: relative;
      overflow: hidden;
      padding: 15px 34px;
      font-family: 'Manrope', sans-serif;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      border: 1px solid var(--glass-border);
      border-radius: 999px;
      background: linear-gradient(135deg, var(--brand-purple) 0%, var(--brand-purple-dark) 100%);
      color: var(--cream);
      cursor: pointer;
      min-width: 200px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.08);
      backdrop-filter: blur(6px);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .plan-button:active {
      transform: scale(0.97);
    }

    .plan-button::after {
      content: "";
      position: absolute;
      top: 0; left: -60%;
      width: 40%; height: 100%;
      background: linear-gradient(120deg, transparent, rgba(212,175,55,0.35), transparent);
      transform: skewX(-20deg);
      animation: shimmer 3.2s ease-in-out infinite;
    }

    @keyframes shimmer {
      0%   { left: -60%; }
      45%  { left: 130%; }
      100% { left: 130%; }
    }

    /* ---------- Instagram / social button ---------- */
    #instagramButton {
      position: fixed;
      bottom: max(25px, env(safe-area-inset-bottom));
      right: 20px;
      width: 48px;
      height: 48px;
      z-index: 1000;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: 14px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.4);
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    #instagramButton:active { transform: scale(0.93); }

    #instagramButton img {
      width: 24px;
      height: 24px;
      filter: sepia(1) saturate(3) hue-rotate(-10deg) brightness(1.15);
    }

    /* REMOVE A-FRAME VR BUTTON COMPLETELY */
    .a-enter-vr,
    .a-enter-ar,
    .a-orientation-modal {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    .mindar-ui-loading, .mindar-ui-compatibility {
      display: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .gem-loader, #loader, #scanHint .scanline, .plan-button::after {
        animation: none !important;
      }
    }
  </style>
</head>

<body>

  <div id="blackCurtain">
    <svg class="gem-loader" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg">
      <path d="M28 4 L48 20 L28 52 L8 20 Z M8 20 L48 20 M18 20 L28 4 L38 20 M18 20 L28 52 M38 20 L28 52" />
    </svg>
    <div id="loader">Initializing<span>Camera &amp; AR</span></div>
  </div>

  <div id="brandMark">JEWELS·AI</div>

  <div id="scanHint">
    <div class="corner tl"></div>
    <div class="corner tr"></div>
    <div class="corner bl"></div>
    <div class="corner br"></div>
    <div class="scanline"></div>
    <p>Align with drive card</p>
  </div>

  <a href="https://www.instagram.com/overlay_gifts_ai/" target="_blank" id="instagramButton">
    <img src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Instagram_icon.png" alt="Instagram">
  </a>

  <div class="button-panel" id="planButtons">
    <button class="plan-button" id="toggleButton">▶ Play Video</button>
  </div>

  <a-scene
    mindar-image="imageTargetSrc: ./targets.mind; uiLoading: no; uiError: no; filterMinCF:0.0001; filterBeta: 0.001;"
    vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false"
    renderer="antialias: true; alpha: true">

    <a-assets>
      <video
        id="driveVideo"
        playsinline
        webkit-playsinline
        preload="auto"
        loop
        crossorigin="anonymous">
      </video>
    </a-assets>

    <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>

    <a-entity id="target1" mindar-image-target="targetIndex: 0">
      <a-plane
        id="videoPlane"
        width="1"
        height="1"
        visible="false"
        material="src: #driveVideo; side: double; transparent: true">
      </a-plane>
    </a-entity>
  </a-scene>

  <script>
    const API_KEY = "AIzaSyA_mBu6emRKASkqHpLtwkdBiCQKYO3rvcw"; 
    const FOLDER_ID = "1jRyVReP4cq7yk1VqwdFCMt0w4on4S77Q";

    async function getLatestVideoId() {
      try {
        const url = `https://www.googleapis.com/drive/v3/files?q='${FOLDER_ID}'+in+parents+and+mimeType+contains+'video/'&orderBy=modifiedTime desc&pageSize=1&fields=files(id)&key=${API_KEY}`;
        const response = await fetch(url);
        const data = await response.json();
        return (data.files && data.files.length > 0) ? data.files[0].id : null;
      } catch (error) {
        console.error("Drive Fetch Error:", error);
        return null;
      }
    }

    window.addEventListener("load", () => {
      const videoEl = document.querySelector("#driveVideo");
      const videoPlane = document.querySelector("#videoPlane");
      const target = document.querySelector("#target1");
      const toggleButton = document.querySelector("#toggleButton");
      const buttonsContainer = document.querySelector("#planButtons");
      const curtain = document.querySelector("#blackCurtain");
      const sceneEl = document.querySelector('a-scene');

      let isPlaying = false;

      function dismissCurtain() {
        if (curtain) {
          curtain.style.opacity = "0";
          setTimeout(() => { curtain.style.display = "none"; }, 600);
        }
      }

      sceneEl.addEventListener("arReady", dismissCurtain);
      sceneEl.addEventListener("arError", (err) => {
        console.error("MindAR failed to start:", err);
        dismissCurtain();
      });

      function adjustPlaneToVideoRatio() {
        if (!videoPlane || !videoEl) return;
        const w = videoEl.videoWidth;
        const h = videoEl.videoHeight;

        if (w > 0 && h > 0) {
          const aspectRatio = w / h;
          const targetWidth = aspectRatio >= 1 ? 1 : aspectRatio;
          const targetHeight = aspectRatio >= 1 ? (1 / aspectRatio) : 1;

          videoPlane.setAttribute('geometry', {
            primitive: 'plane',
            width: targetWidth,
            height: targetHeight
          });
        }
      }

      videoEl.addEventListener('loadedmetadata', adjustPlaneToVideoRatio);
      videoEl.addEventListener('playing', () => {
        adjustPlaneToVideoRatio();
        if (videoPlane) videoPlane.setAttribute('visible', 'true');
      });

      target.addEventListener("targetFound", async () => {
        document.body.classList.add("found");
        buttonsContainer.style.display = "flex";
        const fileId = await getLatestVideoId();
        if (fileId) {
          const newSrc = `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media&key=${API_KEY}`;
          if (videoEl.src !== newSrc) {
            videoEl.src = newSrc;
            videoEl.load();
          }
        }
      });

      target.addEventListener("targetLost", () => {
        document.body.classList.remove("found");
        videoEl.pause();
        if (videoPlane) videoPlane.setAttribute('visible', 'false');
        isPlaying = false;
        toggleButton.textContent = "▶ Play Video";
      });

      toggleButton.addEventListener("click", async () => {
        try {
          if (!isPlaying) {
            videoEl.muted = false;
            await videoEl.play();
            toggleButton.textContent = "⏸ Pause Video";
            isPlaying = true;
          } else {
            videoEl.pause();
            toggleButton.textContent = "▶ Play Video";
            isPlaying = false;
          }
        } catch (err) {
          console.error("Playback error:", err);
        }
      });
    });
  </script>
</body>
</html>
